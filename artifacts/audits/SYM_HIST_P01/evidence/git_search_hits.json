    "hits": [
      {
        "line": 24,
        "text": "- For `GaussianRadialProfile`, `box` uses general diagonal or full metric via analytic Hessian."
      },
      {
        "line": 83,
        "text": "def _fd_hessian(f: Callable[[Array], float], x: Array, h: float = 1e-5) -> Array:"
      },
      {
        "line": 84,
        "text": "    \"\"\"Central finite-diff Hessian (symmetric).\"\"\""
      },
      {
        "line": 229,
        "text": "    def hessian(self, x: ArrayLike) -> Array:"
      },
      {
        "line": 230,
        "text": "        \"\"\"Analytic Hessian for \u03b5 = A exp(-(x\u00b7x)/R^2).\"\"\""
      },
      {
        "line": 241,
        "text": "        H = self.hessian(x)"
      },
      {
        "line": 276,
        "text": "        # Use full Hessian (incl. cross terms) then contract with metric"
      },
      {
        "line": 277,
        "text": "        H = _fd_hessian(self.f_epsilon, x, h=self.fd_step_hess)"
      }
    ]
